# Server
PORT=3000
NODE_ENV=development

# Shared secret the Android app must send as the "X-App-Key" header on
# every /api request. Generate a long random value, e.g.:
#   openssl rand -hex 32
# Set the SAME value here and in the Android app's local.properties as
# LINGUATRANSLATE_APP_API_KEY. Required in production (server refuses
# to start serving /api routes without it when NODE_ENV=production).
APP_API_KEY=

# CORS - comma separated list of allowed origins. Leave empty to block
# all browser-based origins (native Android calls aren't affected by
# CORS). Do NOT use "*" in production.
ALLOWED_ORIGINS=

# Translation provider: "mymemory" | "libretranslate" | "google" | "mock"
# "mymemory" is genuinely free with no API key required (default) - good
# for getting started. "libretranslate.com" now requires a paid API key
# for API access (their public demo UI still works in a browser, but the
# REST API does not without a key) - use LIBRETRANSLATE_BASE_URL to point
# at your own self-hosted instance instead if you want that provider.
# "mock" is for local development/testing only and must never be used in production.
TRANSLATION_PROVIDER=mymemory

# MyMemory (used when TRANSLATION_PROVIDER=mymemory). Optional - adding an
# email here is NOT registration, just raises the free daily limit from
# ~5,000 to ~50,000 characters/day, attributed to this email if you're
# ever contacted about unusual usage.
MYMEMORY_EMAIL=

# LibreTranslate (used when TRANSLATION_PROVIDER=libretranslate). Point
# LIBRETRANSLATE_BASE_URL at a self-hosted instance for free use, or supply
# LIBRETRANSLATE_API_KEY if using the paid libretranslate.com service.
LIBRETRANSLATE_BASE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Google Cloud Translation (if TRANSLATION_PROVIDER=google)
GOOGLE_TRANSLATE_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
TRANSLATE_RATE_LIMIT_PER_MINUTE=20
