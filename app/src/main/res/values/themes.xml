<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns all real theming via LinguaTranslateTheme (Material3).
      This manifest-level theme only needs to exist so the system has
      something to apply before Compose content is set (e.g. splash
      background, status bar) - kept intentionally minimal.
    -->
    <style name="Theme.LinguaTranslate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
